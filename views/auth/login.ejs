<!doctype html><html lang="<%= lang %>" dir="<%= dir %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Sign in · ROVEX MAKER</title><link rel="stylesheet" href="/css/style.css"></head>
<body class="public-body auth-body" dir="<%= dir %>"><form class="language-switch public-language" method="post" action="/language"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="language" aria-label="Language" onchange="this.form.submit()"><option value="en" <%= lang === 'en' ? 'selected' : '' %>>EN</option><option value="ar" <%= lang === 'ar' ? 'selected' : '' %>>AR</option></select></form><a class="brand auth-brand" href="/"><span class="brand-mark">R</span><span>ROVEX <b>MAKER</b></span></a><main class="auth-card"><div class="auth-symbol">R</div><div class="eyebrow"><%= t("welcome_back") %></div><h1><%= t("sign_in") %></h1><p><%= t("manage_intro") %></p><a class="button button-primary button-large full-width" href="/auth/discord"><span class="discord-mark">◉</span> <%= t("continue_discord") %> <span>→</span></a><div class="auth-security"><span>▣</span> OAuth2 identity sign-in. Your Discord password is never requested.</div><a class="text-link" href="/">← <%= t("back_home") %></a></main></body></html>
