<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar') %>
<main class="main-area"><%- include('../partials/topbar', { title }) %><div class="page-content"><%- include('../partials/alerts') %>
  <section class="page-intro"><div class="eyebrow">ACTIVITY CENTER</div><h1>Notifications</h1><p><%= unread %> unread notification(s).</p><form method="post" action="/notifications/read-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-ghost button-small">Mark all as read</button></form></section>
  <div class="notification-list"><% notifications.forEach(n=>{ %><article class="panel notification-card <%= n.read_at?'read':'' %>"><div class="notification-indicator"></div><div class="notification-content"><div class="notification-meta"><span><%= n.kind %></span><time><%= n.created_at %></time></div><h3><%= n.title %></h3><p><%= n.message %></p></div><div class="notification-actions"><% if(!n.read_at){ %><form method="post" action="/notifications/<%= n.id %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-ghost button-small">Read</button></form><% } %><form method="post" action="/notifications/<%= n.id %>/delete" data-confirm="Delete this notification?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger button-small">Delete</button></form></div></article><% }) %><% if(!notifications.length){ %><div class="empty-state panel"><div class="empty-icon">◌</div><h3>You're all caught up</h3><p>System and bot events will appear here.</p></div><% } %></div>
</div></main><%- include('../partials/footer') %>
