<%- include('../partials/head', { title }) %>
<% if(currentUser){ %><%- include('../partials/sidebar') %><main class="main-area"><%- include('../partials/topbar', { title }) %><div class="page-content"><%- include('../partials/alerts') %><% } else { %><%- include('../partials/publicbar') %><main class="public-page-main"><% } %>
  <div class="page-back"><a href="/templates">← Template Marketplace</a></div>
  <section class="template-detail-hero panel"><img class="template-detail-art" src="/images/templates/<%= template.id %>.svg" alt="<%= template.name %> template artwork"><div class="template-detail-copy"><div class="eyebrow"><%= template.category %> · VERSION <%= template.version %></div><h1><%= template.name %></h1><p><%= manifest.description %></p><div class="template-counts"><span><b><%= manifest.commands.length %></b> commands</span><span><b><%= manifest.features.length %></b> features</span><span><b><%= template.uses_count %></b> uses</span></div><div class="template-detail-actions"><% if(template.status==='published' && manifest.support==='ready'){ %><form method="post" action="/templates/<%= template.id %>/use"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary">Use Template →</button></form><% } else { %><span class="template-status preview">PREVIEW ONLY</span><% } %><% if(currentUser){ %><form method="post" action="/templates/<%= template.id %>/favorite"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-ghost"><%= favorite?'Remove Favorite':'Add to Favorites' %></button></form><% } else { %><a class="button button-ghost" href="/login">Sign in to save</a><% } %></div></div></section>
  <% if(manifest.blockers?.length){ %><div class="notice notice-warning"><b>Not installable in this release.</b> <%= manifest.blockers.join(' ') %></div><% } %>
  <div class="detail-columns"><section class="panel section-panel"><h2>Included Features</h2><div class="tag-list"><% manifest.features.forEach(feature=>{ %><span class="soft-tag"><%= feature %></span><% }) %><% if(!manifest.features.length){ %><p>No runtime features are available yet for this template.</p><% } %></div><h2>Commands</h2><div class="saas-list"><% manifest.commands.forEach(command=>{ %><div class="saas-list-item"><code>/<%= command %></code><span class="muted-note">Enabled in template preset</span></div><% }) %><% if(!manifest.commands.length){ %><p>No commands are registered for this preview template.</p><% } %></div></section>
  <section class="panel section-panel"><h2>Requirements</h2><h3>Discord Permissions</h3><div class="tag-list"><% manifest.permissions.forEach(x=>{ %><span class="soft-tag"><%= x %></span><% }) %></div><h3>Gateway Intents</h3><div class="tag-list"><% manifest.intents.forEach(x=>{ %><span class="soft-tag"><%= x %></span><% }) %></div><h3>Events</h3><div class="saas-list"><% manifest.events.forEach(x=>{ %><div class="saas-list-item"><code><%= x %></code></div><% }) %></div><p class="muted-note">Minimum plan: <%= manifest.minPlan %>. Last catalog update: <%= template.updated_at %>.</p></section></div>
</div><% if(currentUser){ %></main><%- include('../partials/footer') %><% } else { %></main></div><footer class="public-page-footer">© 2026 ROVEX MAKER. All rights reserved. · <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a></footer></body></html><% } %>
