<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar') %>
<main class="main-area"><%- include('../partials/topbar', { title }) %><div class="page-content"><%- include('../partials/alerts') %>
  <section class="page-intro"><div class="eyebrow">COLLABORATION / WORKSPACES</div><h1>Team Management</h1><p>Business-plan workspaces allow registered ROVEX MAKER users to share project access.</p></section>
  <% if(!plan.team_enabled){ %><div class="notice notice-warning">Team features require the Business plan. This installation has no payment checkout; an administrator must assign a plan.</div><% } %>
  <section class="panel section-panel"><h2>Create Workspace</h2><form class="inline-form" method="post" action="/team/workspaces"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="input" name="name" minlength="2" maxlength="60" placeholder="Workspace name" required><button class="button button-primary" <%= !plan.team_enabled?'disabled':'' %>>Create</button></form></section>
  <section class="panel section-panel"><h2>Workspace access</h2><% const manageableWorkspaces=workspaces.filter(w=>w.can_manage); %><% if(manageableWorkspaces.length){ %><form class="form-grid" method="post" action="/team/members"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field-label">Workspace<select class="input" name="workspace_id" required><% manageableWorkspaces.forEach(w=>{ %><option value="<%= w.id %>"><%= w.name %></option><% }) %></select></label><label class="field-label">Discord User ID<input class="input" name="discord_id" inputmode="numeric" pattern="[0-9]{15,22}" required placeholder="Registered user's Discord ID"></label><label class="field-label">Role<select class="input" name="role"><option value="administrator">Administrator</option><option value="developer">Developer</option><option value="viewer">Viewer</option></select></label><div class="form-actions"><button class="button button-primary" <%= !plan.team_enabled || !workspaces.length?'disabled':'' %>>Save member</button></div></form><p class="muted-note">The invited person must sign in first. Members are added directly; email invitations are not configured.</p><% } else { %><p class="muted-note">You have no owned workspaces to administer. Shared workspaces appear below and respect your assigned role.</p><% } %></section>
  <section class="panel section-panel"><h2>Workspace bots</h2><% if(manageableWorkspaces.length && ownedBots.length){ manageableWorkspaces.forEach(workspace=>{ %><form class="inline-form workspace-link-form" method="post" action="/team/workspaces/<%= workspace.id %>/bots"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><b><%= workspace.name %></b><select class="input" name="bot_id" required><% ownedBots.forEach(bot=>{ %><option value="<%= bot.id %>"><%= bot.name %></option><% }) %></select><button class="button button-primary button-small">Link</button></form><% }) } else { %><p class="muted-note">Create a workspace and at least one owned bot to link resources.</p><% } %><div class="saas-list"><% workspaceBots.forEach(b=>{ %><div class="saas-list-item"><span><b><%= b.bot_name %></b> · <%= b.workspace_name %></span><% if(b.can_manage){ %><form method="post" action="/team/workspaces/<%= b.workspace_id %>/bots/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="bot_id" value="<%= b.bot_id %>"><button class="button button-danger button-small">Unlink</button></form><% } else { %><span class="muted-note">Shared access</span><% } %></div><% }) %></div></section>
  <section class="panel section-panel"><h2>Workspace Memberships</h2><div class="table-wrap"><table><thead><tr><th>Workspace</th><th>Member</th><th>Discord ID</th><th>Role</th><th>Action</th></tr></thead><tbody><% memberships.forEach(m=>{ %><tr><td><%= m.name %></td><td><%= m.username %></td><td><code><%= m.discord_id %></code></td><td><%= m.role %></td><td><% if(m.can_manage && m.role!=='owner'){ %><form method="post" action="/team/members/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="workspace_id" value="<%= m.id %>"><input type="hidden" name="discord_id" value="<%= m.discord_id %>"><button class="button button-danger button-small">Remove</button></form><% } else { %><span class="muted-note"><%= m.can_manage ? 'Owner' : 'View only' %></span><% } %></td></tr><% }) %></tbody></table></div><% if(!memberships.length){ %><p class="muted-note">No workspace members yet.</p><% } %></section>
</div></main><%- include('../partials/footer') %>
