<%- include('../partials/head', { title }) %>
<% if (currentUser) { %><%- include('../partials/sidebar') %><main class="main-area"><%- include('../partials/topbar', { title }) %><div class="page-content"><%- include('../partials/alerts') %><% } else { %><%- include('../partials/publicbar') %><main class="public-page-main"><% } %>
  <section class="page-intro"><div class="eyebrow">ROVEX MAKER / <%= currentUser ? 'WORKSPACE' : 'PLATFORM' %></div><h1><%= title %></h1><p><%= description %></p></section>
  <% if (notice) { %><div class="notice notice-info"><span><%= notice %></span></div><% } %>
  <% if (stats && stats.length) { %><div class="stat-grid"><% stats.forEach(stat=>{ %><article class="stat-card"><div class="stat-label"><%= stat.label %></div><div class="stat-value"><%= stat.value %></div></article><% }) %></div><% } %>
  <% if (chart && chart.points && chart.points.length) { %><section class="panel section-panel"><div class="section-head"><div><h2><%= chart.title %></h2><p>Counts are calculated from persisted runtime log records.</p></div></div><div class="activity-chart" role="img" aria-label="<%= chart.title %>"><% chart.points.forEach(point=>{ %><div class="activity-column" title="<%= point.date %>: <%= point.value %> events"><b><%= point.value %></b><div class="activity-track"><span class="activity-bar" style="--bar-height:<%= point.height %>%"></span></div><small><%= point.label %></small></div><% }) %></div></section><% } %>
  <% if (form) { %><section class="panel section-panel"><form method="post" action="<%= form.action %>" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% form.fields.forEach(field=>{ %><label class="field-label"><%= field.label %><% if(field.required){ %><em>Required</em><% } %><% if(field.type==='textarea'){ %><textarea class="input textarea" name="<%= field.name %>" required rows="5" maxlength="2000"></textarea><% } else { %><input class="input" name="<%= field.name %>" type="<%= field.type||'text' %>" <%= field.required?'required':'' %> maxlength="2000"><% } %></label><% }) %><div class="form-actions"><button class="button button-primary" type="submit">Submit request</button></div></form></section><% } %>
  <% if (table) { %><section class="panel section-panel"><div class="table-wrap"><table><thead><tr><% table.headers.forEach(h=>{ %><th><%= h %></th><% }) %></tr></thead><tbody><% table.rows.forEach(row=>{ %><tr><% row.forEach(cell=>{ %><td><%= cell %></td><% }) %></tr><% }) %></tbody></table></div></section><% } %>
  <% if (items && items.length) { %><section class="panel section-panel"><div class="section-head"><div><h2>Details</h2><p><%= items.length %> record(s)</p></div></div><div class="saas-list"><% items.forEach(item=>{ %><div class="saas-list-item"><span class="list-bullet"></span><span><%= item %></span></div><% }) %></div></section><% } else if (!stats?.length && !form && !table) { %><section class="panel section-panel empty-state"><div class="empty-icon">◈</div><h3>No records yet</h3><p>Records will appear here when the related system is used.</p></section><% } %>
  <% if (links && links.length) { %><section class="saas-link-grid"><% links.forEach(link=>{ %><a class="saas-link-card" href="<%= link.href %>"><b><%= link.label %></b><span>Open →</span></a><% }) %></section><% } %>
<% if (currentUser) { %></div></main><%- include('../partials/footer') %><% } else { %></main></div><footer class="public-page-footer">© 2026 ROVEX MAKER. All rights reserved. · <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a></footer></body></html><% } %>
