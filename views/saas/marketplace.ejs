<%- include('../partials/head', { title }) %>
<% if(currentUser){ %><%- include('../partials/sidebar') %><main class="main-area"><%- include('../partials/topbar', { title }) %><div class="page-content"><%- include('../partials/alerts') %><% } else { %><%- include('../partials/publicbar') %><main class="public-page-main"><% } %>
  <section class="page-intro marketplace-intro"><div><div class="eyebrow">BUILD FASTER / REUSE MODULES</div><h1>Template Marketplace</h1><p>Explore 25 catalog manifests. Only templates whose commands and runtime modules are included in this release can be installed.</p></div><div class="marketplace-meta"><b><%= templates.filter(t=>t.status==='published').length %></b><span>Installable now</span></div></section>
  <% if(featuredTemplates.length){ %><section class="featured-template-section"><div class="section-head"><div><h2>Featured Templates</h2><p>Selected presets from the supported catalog.</p></div></div><div class="featured-template-row"><% featuredTemplates.forEach(template=>{ %><a class="featured-template" href="/templates/<%= template.id %>"><img src="/images/templates/<%= template.id %>.svg" alt="<%= template.name %> template artwork"><span><b><%= template.name %></b><small><%= template.category %> · <%= template.uses_count %> uses</small></span></a><% }) %></div></section><% } %>
  <form class="marketplace-filter panel" method="get" action="/templates"><div class="search-field"><span>⌕</span><input class="input" name="q" value="<%= query %>" placeholder="Search templates..."></div><select class="input" name="category"><option value="">All categories</option><% categories.forEach(category=>{ %><option value="<%= category %>" <%= selectedCategory===category?'selected':'' %>><%= category %></option><% }) %></select><select class="input" name="tier"><option value="" <%= !tier?'selected':'' %>>Free & Premium</option><option value="free" <%= tier==='free'?'selected':'' %>>Free</option><option value="premium" <%= tier==='premium'?'selected':'' %>>Premium</option></select><select class="input" name="sort"><option value="popular" <%= sort==='popular'?'selected':'' %>>Most used</option><option value="newest" <%= sort==='newest'?'selected':'' %>>Recently updated</option><option value="name" <%= sort==='name'?'selected':'' %>>Name</option></select><button class="button button-primary">Filter</button></form>
  <% if (templates.length) { %><div class="template-grid"><% templates.forEach(template=>{ const manifest=JSON.parse(template.definition_json); %><article class="template-card"><div class="template-card-art"><img src="/images/templates/<%= template.id %>.svg" alt="<%= template.name %> template artwork"></div><div class="template-card-top"><div class="template-symbol"><%= template.name.slice(0,1) %></div><span class="template-status <%= template.status==='published'?'ready':'preview' %>"><%= template.status==='published'?'INSTALLABLE':'PREVIEW' %></span></div><div class="template-category"><%= template.category %> · v<%= template.version %> · <%= template.min_plan==='free'?'FREE':'PREMIUM' %></div><h2><%= template.name %></h2><p><%= template.description %></p><div class="template-counts"><span><b><%= manifest.commands.length %></b> commands</span><span><b><%= manifest.features.length %></b> modules</span><span><b><%= template.uses_count %></b> installs</span></div><div class="template-card-foot"><% if(currentUser){ %><form method="post" action="/templates/<%= template.id %>/favorite"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-ghost button-small" title="Toggle favorite"><%= Number(template.favorite)?'★ Saved':'☆ Favorite' %></button></form><% } %><a class="button button-ghost button-small" href="/templates/<%= template.id %>">Preview</a><% if(template.status==='published' && manifest.support==='ready'){ %><form method="post" action="/templates/<%= template.id %>/use"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary button-small">Use template</button></form><% } else { %><span class="muted-note">Runtime module not ready</span><% } %></div></article><% }) %></div><% } else { %><div class="empty-state panel"><h3>No templates found</h3><p>Try a different search or category.</p></div><% } %>
</div><% if(currentUser){ %></main><%- include('../partials/footer') %><% } else { %></main></div><footer class="public-page-footer">© 2026 ROVEX MAKER. All rights reserved. · <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a></footer></body></html><% } %>
