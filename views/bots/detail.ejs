<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar') %>
<main class="main-area"><%- include('../partials/topbar', { title }) %><div class="page-content"><%- include('../partials/alerts') %>
  <div class="page-back"><a href="/bots">← My bots</a></div>
  <section class="bot-hero"><div class="bot-hero-main"><div class="bot-avatar bot-avatar-large"><% if (bot.avatar_url) { %><img src="<%= bot.avatar_url %>" alt=""><% } else { %>◈<% } %></div><div><div class="eyebrow">BOT WORKSPACE</div><h1><%= bot.name %></h1><p><%= bot.description || 'No description provided.' %></p><div class="bot-meta-line"><span class="status-badge status-<%= bot.status %>"><i></i><%= bot.status %></span><span>Application ID: <code><%= bot.client_id %></code></span><% if(bot.access_role && bot.access_role!=='owner'){ %><span class="count-pill"><%= bot.access_role %> access</span><% } %></div></div></div>
    <% if (bot.access_role !== 'viewer') { %><div class="bot-control-actions">
      <form method="post" action="/bots/<%= bot.id %>/control/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary" <%= bot.status === 'online' || bot.status === 'starting' ? 'disabled' : '' %>>▶ Start</button></form>
      <form method="post" action="/bots/<%= bot.id %>/control/restart"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-ghost">↻ Restart</button></form>
      <form method="post" action="/bots/<%= bot.id %>/control/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-ghost" <%= bot.status === 'offline' ? 'disabled' : '' %>>■ Stop</button></form>
    </div><% } else { %><span class="muted-note">Read-only workspace access</span><% } %>
  </section>
  <nav class="bot-subnav" aria-label="Bot sections">
    <a href="/bots/<%= bot.id %>">Overview</a><a href="/bots/<%= bot.id %>/analytics">Analytics</a><a href="/bots/<%= bot.id %>/commands">Commands</a><a href="/bots/<%= bot.id %>/features">Features</a><a href="/bots/<%= bot.id %>/servers">Servers</a><a href="/bots/<%= bot.id %>/logs">Logs</a><a href="/bots/<%= bot.id %>/integrations">Integrations</a><a href="/bots/<%= bot.id %>/export">Export</a>
  </nav>
  <div class="detail-stats"><article class="mini-stat"><small>GUILDS</small><b><%= guilds.length %></b><span>Known server count</span></article><article class="mini-stat"><small>COMMANDS</small><b><%= commandRows.filter(x => x.enabled).length %><small> / <%= commandRows.length %></small></b><span>Enabled slash commands</span></article><article class="mini-stat"><small>CREATED</small><b class="small-stat"><%= new Date(bot.created_at + 'Z').toLocaleDateString() %></b><span>Platform registration</span></article><article class="mini-stat"><small>LAST STARTED</small><b class="small-stat"><%= bot.last_started_at ? new Date(bot.last_started_at + 'Z').toLocaleString() : 'Never' %></b><span>Recorded runtime start</span></article></div>
  <div class="detail-grid">
    <section class="panel section-panel"><div class="section-head"><div><h2>Bot profile</h2><p>Platform display settings. This does not change the Discord application profile.</p></div></div>
      <% if(bot.access_role !== 'viewer'){ %><form method="post" action="/bots/<%= bot.id %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field-label">Display name</label><input class="input" name="name" value="<%= bot.name %>" required minlength="2" maxlength="48"><label class="field-label">Description</label><textarea class="input textarea" rows="2" name="description" maxlength="240"><%= bot.description %></textarea><label class="field-label">Dashboard avatar URL</label><input class="input" name="avatar_url" type="url" value="<%= bot.avatar_url || '' %>" placeholder="https://..."><div class="form-actions"><button class="button button-primary button-small">Save profile</button></div></form><% } else { %><p class="muted-note">Your workspace role is read-only.</p><% } %>
    </section>
    <section class="panel section-panel"><div class="section-head"><div><h2>Platform invite</h2><p>Use this link to add the bot to a server. Review permissions before authorizing.</p></div></div><div class="invite-box"><code id="invite-url">https://discord.com/oauth2/authorize?client_id=<%= bot.client_id %>&scope=bot%20applications.commands&permissions=1099511753814</code><button type="button" class="button button-ghost button-small" data-copy-target="invite-url">Copy</button></div><a class="text-link" href="https://discord.com/oauth2/authorize?client_id=<%= bot.client_id %>&scope=bot%20applications.commands&permissions=1099511753814" target="_blank" rel="noopener noreferrer">Open Discord authorization ↗</a><p class="muted-note compact-note">The invite link requests the permissions used by the included modules. Disable unused modules or reduce permissions further before inviting the bot to a public server.</p></section>
  </div>
  <% if(bot.access_role !== 'viewer'){ %><section class="panel section-panel"><div class="section-head"><div><h2>Feature modules</h2><p>Toggle modules. A running bot restarts to apply any required Gateway intent changes.</p></div></div><div class="module-grid">
    <% featuresRows.forEach(item => { %><div class="module-row"><div class="module-icon"><%= ({moderation:'⚒',automod:'◈',welcome:'✦',tickets:'▤',giveaways:'✧',leveling:'↗',economy:'◉',logging:'≋',utility:'⌘',music:'♫',temp_voice:'◉',reaction_roles:'♧',suggestions:'✎',ai_assistant:'✦',translator:'文',birthday:'✧',counting:'#',starboard:'★',verification:'✓',invite_tracker:'↗',server_statistics:'▥'})[item.feature_key] || '◈' %></div><div class="module-copy"><b><%= t(item.feature_key) %></b><small><%= ({moderation:'Member moderation and channel controls',automod:'Spam, links, caps and mention filtering',welcome:'Join and leave messages',tickets:'Private support channels',giveaways:'Free-entry community giveaways',leveling:'XP progression and leaderboards',economy:'Daily virtual coins and quiz rewards',logging:'Server event log delivery',utility:'Information, polls and utility commands',music:'Licensed direct Ogg/Opus voice playback',temp_voice:'Join-to-create voice rooms with automatic cleanup',reaction_roles:'Persistent role buttons with permission checks',suggestions:'Member suggestions and voting controls',ai_assistant:'AI answers using your encrypted OpenAI integration',translator:'Text translation through your configured provider',birthday:'Birthday storage and automated greetings',counting:'Persistent channel counting with anti-double-post checks',starboard:'Promote messages that reach the configured star threshold',verification:'Verification panel and role assignment',invite_tracker:'Invite-use tracking and attribution',server_statistics:'Live server member and channel counter'})[item.feature_key] %></small></div><form method="post" action="/bots/<%= bot.id %>/features/<%= item.feature_key %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="enabled" value="<%= item.enabled ? '0' : '1' %>"><button class="toggle-button <%= item.enabled ? 'is-on' : '' %>"><span></span><%= item.enabled ? 'Enabled' : 'Disabled' %></button></form></div><% }) %>
  </div></section>
  <section class="panel section-panel"><div class="section-head"><div><h2><%= t('automatic_start') %></h2><p>Restore this bot after the platform process starts, subject to hosting limits.</p></div></div>
    <form method="post" action="/bots/<%= bot.id %>/auto-start" class="inline-setting-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="enabled" value="<%= bot.auto_start ? '0' : '1' %>"><span><%= bot.auto_start ? 'Enabled' : 'Disabled' %></span><button class="button button-ghost button-small"><%= bot.auto_start ? 'Disable auto-start' : 'Enable auto-start' %></button></form>
  </section>
  <section class="panel section-panel"><div class="section-head"><div><h2>Slash command manager</h2><p>Enable or disable commands and synchronize the command list with Discord.</p></div><form method="post" action="/bots/<%= bot.id %>/sync-commands"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-ghost button-small">↻ Sync commands</button></form></div><div class="command-list"><% commandRows.forEach(item => { %><div class="command-row"><span class="command-slash">/</span><code><%= item.command_name %></code><form method="post" action="/bots/<%= bot.id %>/commands/<%= item.command_name %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="command-state <%= item.enabled ? 'is-enabled' : '' %>"><%= item.enabled ? 'Enabled' : 'Disabled' %></button></form></div><% }) %></div></section><% } %>
  <div class="detail-grid">
    <section class="panel section-panel"><div class="section-head"><div><h2>Connected servers</h2><p>Guilds visible to the active Discord client.</p></div><span class="count-pill"><%= guilds.length %></span></div><% if (!guilds.length) { %><div class="empty-inline">No servers are currently visible to this bot.</div><% } else { %><div class="guild-list"><% guilds.forEach(g => { %><div class="guild-row"><div class="guild-avatar">◇</div><div><b><%= g.guild_name %></b><small><%= g.member_count %> members · <code><%= g.guild_id %></code></small></div></div><% }) %></div><% } %></section>
    <section class="panel section-panel"><div class="section-head"><div><h2>Latest activity</h2><p>Recent runtime and command events.</p></div><a class="text-link" href="/bots/<%= bot.id %>/logs">View all logs →</a></div><% if (!logs.length) { %><div class="empty-inline">No log events recorded yet.</div><% } else { %><div class="log-list"><% logs.forEach(entry => { %><div class="log-row"><span class="log-level level-<%= entry.level %>"><%= entry.level %></span><div><b><%= entry.category %></b><p><%= entry.message %></p><small><%= new Date(entry.created_at + 'Z').toLocaleString() %></small></div></div><% }) %></div><% } %></section>
  </div>
  <% if(bot.access_role !== 'viewer'){ %><section class="panel section-panel"><div class="section-head"><div><h2><%= t('shop') %></h2><p>Create virtual coin items for one Discord server. Items may optionally grant a server role; this feature does not use real money or wagers.</p></div></div>
    <form method="post" action="/bots/<%= bot.id %>/shop-items" class="settings-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label><span class="field-label"><%= t('guild_id') %></span><input class="input" name="guild_id" required pattern="[0-9]{15,22}" placeholder="123456789012345678"></label>
      <label><span class="field-label"><%= t('item_name') %></span><input class="input" name="name" required minlength="2" maxlength="50" placeholder="VIP role"></label>
      <label><span class="field-label"><%= t('price') %></span><input class="input" type="number" name="price" required min="1" max="100000000" placeholder="500"></label>
      <label><span class="field-label"><%= t('stock') %></span><input class="input" type="number" name="stock" value="-1" min="-1" max="1000000"></label>
      <label class="wide-field"><span class="field-label"><%= t('description') %></span><input class="input" name="description" maxlength="160" placeholder="A permanent role reward"></label>
      <label class="wide-field"><span class="field-label"><%= t('reward_role_id') %></span><input class="input" name="reward_role_id" pattern="[0-9]{15,22}" placeholder="Optional Discord role ID"></label>
      <div class="wide-field form-actions"><button class="button button-primary button-small"><%= t('save_item') %></button></div>
    </form>
    <% if (shopItems.length) { %><div class="table-wrap top-gap"><table><thead><tr><th>SERVER</th><th>ITEM</th><th>PRICE</th><th>STOCK</th><th>STATUS</th><th>ACTION</th></tr></thead><tbody><% shopItems.forEach(item => { %><tr><td><code><%= item.guild_id %></code></td><td><b><%= item.name %></b><small><%= item.reward_role_id ? `Role ${item.reward_role_id}` : 'No role reward' %></small></td><td><%= item.price %> coins</td><td><%= item.stock < 0 ? 'Unlimited' : item.stock %></td><td><%= item.enabled ? 'Enabled' : 'Disabled' %></td><td><form method="post" action="/bots/<%= bot.id %>/shop-items/<%= item.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-ghost button-small"><%= item.enabled ? 'Disable' : 'Enable' %></button></form></td></tr><% }) %></tbody></table></div><% } %>
  </section>
  <section class="panel section-panel"><div class="section-head"><div><h2><%= t('level_rewards') %></h2><p>Grant a Discord role automatically when a member reaches the configured XP level.</p></div></div>
    <form method="post" action="/bots/<%= bot.id %>/level-rewards" class="settings-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label><span class="field-label"><%= t('guild_id') %></span><input class="input" name="guild_id" required pattern="[0-9]{15,22}" placeholder="123456789012345678"></label>
      <label><span class="field-label"><%= t('required_level') %></span><input class="input" name="level" type="number" required min="1" max="1000" placeholder="10"></label>
      <label class="wide-field"><span class="field-label"><%= t('role_id') %></span><input class="input" name="role_id" required pattern="[0-9]{15,22}" placeholder="987654321098765432"></label>
      <div class="wide-field form-actions"><button class="button button-primary button-small"><%= t('save_reward') %></button></div>
    </form>
    <% if (levelRewards.length) { %><div class="table-wrap top-gap"><table><thead><tr><th>SERVER</th><th>LEVEL</th><th>ROLE ID</th></tr></thead><tbody><% levelRewards.forEach(reward => { %><tr><td><code><%= reward.guild_id %></code></td><td><b><%= reward.level %></b></td><td><code><%= reward.role_id %></code></td></tr><% }) %></tbody></table></div><% } %>
  </section>
  <% } %>
  <% if(bot.access_role === 'owner'){ %><section class="danger-zone"><div><h3>Delete this bot from the platform</h3><p>Stops the runtime and permanently removes its encrypted token and platform data. The Discord application itself is not deleted.</p></div><form method="post" action="/bots/<%= bot.id %>/delete" data-confirm="Delete this bot and all platform data? This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger button-small">Delete bot</button></form></section>
  <% } %>
  <div class="muted-note">Server-specific welcome, leave and image settings are configured using <code>/set-welcome</code> with the optional <code>image_url</code>, and logs using <code>/set-logs</code> inside each Discord server. AutoMod options are stored per server; defaults are defensive spam mass-mention filtering and join-spike alerts.</div>
</div></main><%- include('../partials/footer') %>
