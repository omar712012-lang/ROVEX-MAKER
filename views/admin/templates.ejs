<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar') %>
<main class="main-area"><%- include('../partials/topbar', { title }) %><div class="page-content"><%- include('../partials/alerts') %>
  <section class="page-intro"><div class="eyebrow">PLATFORM ADMINISTRATION / MARKETPLACE</div><h1>Template Management</h1><p>Create safe manifests from existing platform modules, review changes, publish compatible templates, and hide or delete unused entries. Templates cannot upload or execute JavaScript.</p></section>
  <section class="panel section-panel"><div class="section-head"><div><h2>Create a template draft</h2><p>Only the built-in runtime commands and feature modules are accepted. New drafts start in Preview.</p></div></div>
    <form class="form-grid template-admin-form" method="post" action="/admin/templates"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field-label">Template ID<input class="input" name="id" required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="48" placeholder="my-community-bot"></label>
      <label class="field-label">Name<input class="input" name="name" required minlength="3" maxlength="80"></label>
      <label class="field-label">Category<input class="input" name="category" required minlength="2" maxlength="40" placeholder="Community"></label>
      <label class="field-label">Minimum plan<select class="input" name="min_plan"><% plans.forEach(plan=>{ %><option value="<%= plan.key %>"><%= plan.name %></option><% }) %></select></label>
      <label class="field-label">Version<input class="input" name="version" value="1.0.0" pattern="[0-9]+\.[0-9]+\.[0-9]+" required></label>
      <label class="field-label full-field">Description<textarea class="input textarea" name="description" minlength="20" maxlength="500" required rows="2"></textarea></label>
      <label class="field-label full-field">Feature modules (comma-separated)<input class="input" name="features" required placeholder="moderation, utility"></label>
      <label class="field-label full-field">Slash commands (comma-separated)<input class="input" name="commands" required placeholder="help, ping, serverinfo"></label>
      <label class="field-label full-field">Discord permissions (comma-separated)<input class="input" name="permissions" placeholder="View Channels, Send Messages, Embed Links"></label>
      <label class="field-label full-field">Gateway intents (comma-separated)<input class="input" name="intents" placeholder="Guilds, GuildMembers"></label>
      <label class="field-label full-field">Discord events (comma-separated)<input class="input" name="events" placeholder="interactionCreate, guildMemberAdd"></label>
      <div class="form-actions"><button class="button button-primary" type="submit">Create Preview Draft</button></div>
    </form>
  </section>
  <section class="panel section-panel"><div class="section-head"><div><h2>Catalog manifests</h2><p><%= templates.length %> template(s) currently stored.</p></div></div>
    <% templates.forEach(t=>{ %><details class="admin-template-row"><summary><span><b><%= t.name %></b><small><code><%= t.id %></code> · <%= t.category %> · v<%= t.version %> · <%= t.uses_count %> installs</small></span><span class="template-status <%= t.status==='published'?'ready':'preview' %>"><%= t.status %></span></summary>
      <div class="admin-template-body"><div class="template-counts"><span><b><%= t.manifest.commands.length %></b> commands</span><span><b><%= t.manifest.features.length %></b> modules</span><span><b><%= t.min_plan %></b> minimum plan</span><span><b><%= t.builtin?'Built-in':'Custom' %></b> source</span></div>
        <% if(t.manifest.support==='ready'){ %><form class="form-grid template-admin-form" method="post" action="/admin/templates/<%= t.id %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field-label">Name<input class="input" name="name" value="<%= t.name %>" required maxlength="80"></label><label class="field-label">Category<input class="input" name="category" value="<%= t.category %>" required maxlength="40"></label><label class="field-label">Minimum plan<select class="input" name="min_plan"><% plans.forEach(plan=>{ %><option value="<%= plan.key %>" <%= plan.key===t.min_plan?'selected':'' %>><%= plan.name %></option><% }) %></select></label><label class="field-label">New version<input class="input" name="version" value="<%= t.version.split('.')[0] %>.<%= Number(t.version.split('.')[1]||0)+1 %>.0" required></label><label class="field-label full-field">Description<textarea class="input textarea" name="description" minlength="20" maxlength="500" required rows="2"><%= t.description %></textarea></label><label class="field-label full-field">Feature modules<input class="input" name="features" value="<%= t.manifest.features.join(', ') %>" required></label><label class="field-label full-field">Slash commands<input class="input" name="commands" value="<%= t.manifest.commands.join(', ') %>" required></label><label class="field-label full-field">Discord permissions<input class="input" name="permissions" value="<%= t.manifest.permissions.join(', ') %>"></label><label class="field-label full-field">Gateway intents<input class="input" name="intents" value="<%= t.manifest.intents.join(', ') %>"></label><label class="field-label full-field">Events<input class="input" name="events" value="<%= t.manifest.events.join(', ') %>"></label><label class="field-label full-field">Changelog<input class="input" name="changelog" value="Template manifest update." maxlength="500"></label><div class="form-actions"><button class="button button-ghost" type="submit">Save New Version as Preview</button></div></form><% } else { %><div class="notice notice-warning">Preview-only: <%= (t.manifest.blockers||[]).join(' ') %></div><% } %>
        <div class="template-admin-actions"><form method="post" action="/admin/templates/<%= t.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="input" name="status"><option value="published" <%= t.status==='published'?'selected':'' %> <%= t.manifest.support!=='ready'?'disabled':'' %>>Published</option><option value="hidden" <%= t.status==='hidden'?'selected':'' %>>Hidden</option><option value="preview" <%= t.status==='preview'?'selected':'' %>>Preview</option></select><button class="button button-primary button-small" type="submit">Update Status</button></form>
        <% if(!t.builtin){ %><form method="post" action="/admin/templates/<%= t.id %>/delete" data-confirm="Delete this unused custom template and its version history?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger button-small" type="submit">Delete Custom Template</button></form><% } %></div>
      </div></details><% }) %>
  </section>
</div></main><%- include('../partials/footer') %>
