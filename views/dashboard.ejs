<%- include('partials/head', { title }) %>
<%- include('partials/sidebar') %>
<main class="main-area"><%- include('partials/topbar', { title }) %><div class="page-content"><%- include('partials/alerts') %>
  <section class="welcome-row"><div><div class="eyebrow"><%= t("overview") %></div><h1><%= t("welcome_back") %>، <%= currentUser.global_name || currentUser.username %>.</h1><p><%= t("manage_intro") %></p></div><a class="button button-primary" href="/bots/new">＋ <%= t("create_bot") %></a></section>
  <div class="stat-grid">
    <article class="stat-card"><div class="stat-label">Total Bots <span>⌘</span></div><div class="stat-value"><%= stats.total %><small> / <%= maxBots %></small></div><div class="stat-foot"><%= plan.name %> allocation</div></article>
    <article class="stat-card"><div class="stat-label">Online Bots <span class="green">●</span></div><div class="stat-value"><%= stats.online %></div><div class="stat-foot"><span class="status-dot"></span> Connected to Discord</div></article>
    <article class="stat-card"><div class="stat-label">Offline / Other <span>◌</span></div><div class="stat-value"><%= stats.offline %></div><div class="stat-foot">Offline, starting or error</div></article>
    <article class="stat-card"><div class="stat-label">Known Servers <span>⌁</span></div><div class="stat-value"><%= stats.guilds %></div><div class="stat-foot">Last bot sync snapshots</div></article>
  </div>
  <section class="panel section-panel"><div class="section-head"><div><h2>Runtime Activity</h2><p>Bot log events recorded over the last seven days.</p></div><a class="text-link" href="/analytics">Full analytics →</a></div><div class="activity-chart" role="img" aria-label="Daily runtime log counts for the last seven days"><% activity.forEach(point=>{ %><div class="activity-column" title="<%= point.date %>: <%= point.count %> events"><b><%= point.count %></b><div class="activity-track"><span class="activity-bar" style="--bar-height:<%= point.height %>%"></span></div><small><%= point.label %></small></div><% }) %></div></section>
  <div class="dashboard-shortcuts"><a class="shortcut-card" href="/templates"><span>▧</span><b>Explore templates</b><small>Install a supported preset</small></a><a class="shortcut-card" href="/subscription"><span>◇</span><b><%= plan.name %> plan</b><small><%= plan.running_limit %> concurrent runtime slots</small></a><a class="shortcut-card" href="/notifications"><span>♢</span><b>Notifications</b><small><%= notifications.length %> unread items</small></a></div>
  <% if (notifications.length) { %><section class="panel notification-summary"><div class="section-head"><div><h2>Latest Notifications</h2><p>Unread platform and bot events.</p></div><a class="text-link" href="/notifications">View all →</a></div><% notifications.forEach(n=>{ %><div class="saas-list-item"><b><%= n.title %></b><span><%= n.message %></span><small><%= n.created_at %></small></div><% }) %></section><% } %>
  <section class="section-block"><div class="section-head"><div><h2><%= t("your_bots") %></h2><p><%= t("recently_created") %></p></div><a class="text-link" href="/bots"><%= t("view_all") %> →</a></div>
    <% if (!bots.length) { %><div class="empty-state"><div class="empty-icon">⌘</div><h3><%= t("no_bots") %></h3><p><%= t("create_first_bot") %> to start managing commands, modules and runtime status.</p><a class="button button-primary" href="/bots/new"><%= t("create_first_bot") %></a></div><% } else { %>
      <div class="bot-grid"><% bots.forEach(bot => { %><a class="bot-card" href="/bots/<%= bot.id %>"><div class="bot-card-top"><div class="bot-avatar"><% if (bot.avatar_url) { %><img src="<%= bot.avatar_url %>" alt=""><% } else { %>◈<% } %></div><span class="status-badge status-<%= bot.status %>"><i></i><%= bot.status %></span></div><h3><%= bot.name %></h3><p><%= bot.description || 'No description provided.' %></p><div class="bot-card-foot"><span>Created <%= new Date(bot.created_at + 'Z').toLocaleDateString() %></span><span><%= bot.access_role === 'viewer' ? 'View shared bot →' : 'Open workspace →' %></span></div></a><% }) %></div>
    <% } %>
  </section>
  <section class="info-banner"><div class="info-icon">i</div><div><b><%= t("runtime_real") %></b><p><%= t("runtime_explainer") %> Hosting sleep and process limits can interrupt uptime.</p></div></section>
</div></main><%- include('partials/footer') %>
