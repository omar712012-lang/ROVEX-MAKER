<%- include('partials/head', { title }) %>
<%- include('partials/sidebar') %>
<main class="main-area"><%- include('partials/topbar', { title }) %><div class="page-content"><%- include('partials/alerts') %>
  <section class="welcome-row"><div><div class="eyebrow">PLATFORM OPERATIONS</div><h1><%= t('admin_panel') %></h1><p>Manage accounts, operate runtimes and review administrator actions.</p></div></section>
  <div class="stat-grid">
    <article class="stat-card"><div class="stat-label"><%= t('users') %></div><div class="stat-value"><%= totals.users %></div><div class="stat-foot">Discord identities registered</div></article>
    <article class="stat-card"><div class="stat-label"><%= t('bots') %></div><div class="stat-value"><%= totals.bots %></div><div class="stat-foot">Saved bot applications</div></article>
    <article class="stat-card"><div class="stat-label"><%= t('online_bots') %></div><div class="stat-value"><%= totals.online %></div><div class="stat-foot">Connected in this process</div></article>
  </div>
  <section class="panel section-panel"><div class="section-head"><div><h2><%= t('recent_bots') %></h2><p>Administrator controls affect the live runtime and platform records.</p></div></div><div class="table-wrap"><table><thead><tr><th>BOT</th><th><%= t('owner') %></th><th><%= t('status') %></th><th><%= t('created') %></th><th><%= t('actions') %></th></tr></thead><tbody>
    <% bots.forEach(bot => { %><tr><td><b><%= bot.name %></b><small><code><%= bot.id %></code></small></td><td><%= bot.username %><small><%= bot.discord_id %></small></td><td><span class="status-badge status-<%= bot.status %>"><i></i><%= bot.status %></span></td><td><%= new Date(bot.created_at + 'Z').toLocaleString() %></td><td><div class="admin-actions">
      <% ['start','restart','stop'].forEach(action => { %><form method="post" action="/admin/bots/<%= bot.id %>/<%= action %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-ghost button-small"><%= t(action) %></button></form><% }) %>
      <form method="post" action="/admin/bots/<%= bot.id %>/delete" data-confirm="Permanently delete this bot and all platform records?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger button-small">Delete</button></form>
    </div></td></tr><% }) %>
  </tbody></table></div></section>
  <section class="panel section-panel"><div class="section-head"><div><h2><%= t('recent_users') %></h2><p>Suspend or restore access to platform accounts. Administrator accounts are protected from self-suspension.</p></div></div><div class="table-wrap"><table><thead><tr><th>USER</th><th>DISCORD ID</th><th>LAST LOGIN</th><th><%= t('status') %></th><th><%= t('actions') %></th></tr></thead><tbody>
    <% users.forEach(user => { %><tr><td><b><%= user.username %></b><small>Platform #<%= user.id %></small></td><td><code><%= user.discord_id %></code></td><td><%= new Date(user.last_login_at + 'Z').toLocaleString() %></td><td><span class="status-badge <%= user.is_suspended ? 'status-error' : 'status-online' %>"><i></i><%= user.is_suspended ? 'Suspended' : 'Active' %></span></td><td><form method="post" action="/admin/users/<%= user.id %>/suspension"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button <%= user.is_suspended ? 'button-primary' : 'button-danger' %> button-small"><%= user.is_suspended ? t('restore') : t('suspend') %></button></form></td></tr><% }) %>
  </tbody></table></div></section>
  <section class="panel section-panel"><div class="section-head"><div><h2><%= t('activity_audit') %></h2><p>Recent administrator operations, target identifiers and timestamps.</p></div></div><div class="table-wrap"><table><thead><tr><th>ADMIN</th><th>ACTION</th><th>TARGET</th><th>DETAILS</th><th>TIME</th></tr></thead><tbody><% auditLogs.forEach(item => { %><tr><td><code><%= item.admin_discord_id %></code></td><td><b><%= item.action %></b></td><td><code><%= item.target %></code></td><td><%= item.details %></td><td><%= new Date(item.created_at + 'Z').toLocaleString() %></td></tr><% }) %></tbody></table></div></section>
</div></main><%- include('partials/footer') %>
